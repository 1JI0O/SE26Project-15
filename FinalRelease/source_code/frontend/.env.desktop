VITE_RUNTIME_MODE=desktop
VITE_API_BASE_URL=http://127.0.0.1:8765/api/v1
# Unified TraceLab cloud — desktop builds ship with this server baked in.
# Users do not configure a remote URL themselves.
#
# Desktop routes cloud calls through the local backend's loopback reverse proxy
# (see backend/app/api/routes/cloud_proxy.py). The WebView cannot accept the
# server's self-signed certificate, so it never talks to the IP directly. The
# upstream server + pinned CA are configured backend-side (TRACELAB_CLOUD_*).
VITE_CLOUD_API_BASE_URL=http://127.0.0.1:8765/cloud-api/v1
