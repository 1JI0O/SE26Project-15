APP_ENV=production
DATABASE_URL=postgresql+psycopg://tracelab:replace-database-password@postgres:5432/tracelab
PUBLIC_ORIGIN=https://sync.tracelab.example.com
ACCOUNT_LINK_ORIGIN=https://app.tracelab.example.com
ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,https://app.tracelab.example.com
CLOUD_JWT_SECRET=replace-with-at-least-32-random-bytes
CLOUD_COOKIE_SECURE=true
CLOUD_SYNC_FEATURE_ENABLED=false
CLOUD_REQUIRE_EMAIL_VERIFICATION=true

CLOUD_ACCOUNT_QUOTA_BYTES=5368709120
CLOUD_PROJECT_QUOTA_BYTES=2147483648
CLOUD_PDF_MAX_BYTES=104857600
CLOUD_ZIP_MAX_BYTES=524288000
CLOUD_DISK_WARN_PERCENT=80
CLOUD_DISK_STOP_PERCENT=90
CLOUD_BLOB_GC_GRACE_DAYS=7
CLOUD_EVENT_RETENTION_DAYS=30

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

BACKUP_REMOTE=remote:tracelab-production
POSTGRES_USER=tracelab
POSTGRES_PASSWORD=replace-database-password
POSTGRES_DB=tracelab
SERVER_NAME=sync.tracelab.example.com
RCLONE_CONFIG_PATH=/root/.config/rclone/rclone.conf
TRACELAB_DATA_ROOT=/srv/tracelab
TRACELAB_ACME_ROOT=/var/www/acme
