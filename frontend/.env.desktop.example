VITE_RUNTIME_MODE=desktop
VITE_API_BASE_URL=http://127.0.0.1:8765/api/v1
# Unified TraceLab cloud server. Desktop builds route cloud calls through the
# local backend's loopback reverse proxy so the WebView never has to accept the
# server's self-signed certificate. Configure the real upstream + pinned CA in
# the backend (TRACELAB_CLOUD_UPSTREAM / TRACELAB_CLOUD_CA_FILE).
VITE_CLOUD_API_BASE_URL=http://127.0.0.1:8765/cloud-api/v1
