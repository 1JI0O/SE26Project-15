{
  "name": "paper-code-trace-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm assets:pdfjs && vite --host 127.0.0.1",
    "dev:desktop": "pnpm assets:pdfjs && vite --mode desktop --host 127.0.0.1",
    "build": "pnpm assets:pdfjs && vue-tsc --noEmit && vite build",
    "assets:pdfjs": "node scripts/copy-pdfjs-assets.mjs",
    "build:sidecar": "node scripts/build-backend-sidecar.mjs",
    "build:desktop": "pnpm build:sidecar && pnpm assets:pdfjs && vue-tsc --noEmit && vite build --mode desktop",
    "desktop:dev": "pnpm build:sidecar && tauri dev",
    "desktop:build": "tauri build --bundles app,dmg",
    "test:unit": "vitest run",
    "test:system": "playwright test --config=playwright.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/lsp-client": "^6.2.5",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@element-plus/icons-vue": "^2.3.1",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.7.7",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.12",
    "element-plus": "^2.8.4",
    "katex": "^0.17.0",
    "markdown-it": "^14.3.0",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^2.2.2",
    "tauri-pty": "^0.3.1",
    "vue": "^3.5.8",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.1.4",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.6"
  }
}
