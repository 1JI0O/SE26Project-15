          "documentation": "系统扫描已导入仓库的文件树，并提取类、函数、导入和模型结构候选。"
        },
        {
          "_type": "UMLUseCase",
          "_id": "uc_read_paper",
          "_parent": {
            "$ref": "tracelab_use_case_model"
          },
