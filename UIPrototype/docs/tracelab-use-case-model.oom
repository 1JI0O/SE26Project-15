            <a:ObjectID>31BC79BF-5310-48FA-9241-E0783C7DC848</a:ObjectID>
            <a:Name>外部 AI/分析服务</a:Name>
            <a:Code>ExternalAIAnalysisService</a:Code>
            <a:Comment>提供向量检索、LLM 解释、代码影响分析等可替换能力。</a:Comment>
          </o:Actor>
        </c:Actors>

