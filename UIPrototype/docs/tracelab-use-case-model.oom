        <c:Actors>
          <o:Actor Id="o100">
            <a:ObjectID>6358D885-D8DB-48C7-B731-B0A567C77E6F</a:ObjectID>
            <a:Name>复现研究人员</a:Name>
            <a:Code>Researcher</a:Code>
            <a:Comment>主要用户，上传论文和代码，审阅追溯关系并修正结果。</a:Comment>
          </o:Actor>
          <o:Actor Id="o101">
            <a:ObjectID>C27A1C18-7D5C-4BC6-A7A2-FA7F11013DBE</a:ObjectID>
            <a:Name>项目负责人</a:Name>
            <a:Code>ProjectOwner</a:Code>
            <a:Comment>查看项目进度、质量门禁、冲突风险和最终报告。</a:Comment>
