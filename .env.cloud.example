APP_ENV=production
RUNTIME_MODE=cloud
SERVER_NAME=tracelab.example.com
CLOUD_PUBLIC_ORIGIN=https://tracelab.example.com
CLOUD_COOKIE_SECURE=true
CLOUD_JWT_SECRET=replace-with-at-least-32-random-bytes
POSTGRES_USER=tracelab
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=tracelab
BACKEND_CORS_ORIGINS=https://tracelab.example.com,tauri://localhost,http://tauri.localhost,https://tauri.localhost

CLOUD_ACCOUNT_QUOTA_BYTES=5368709120
CLOUD_PROJECT_QUOTA_BYTES=2147483648
CLOUD_PDF_MAX_BYTES=104857600
CLOUD_ZIP_MAX_BYTES=524288000
CLOUD_DISK_WARN_PERCENT=80
CLOUD_DISK_STOP_PERCENT=90
CLOUD_BLOB_GC_GRACE_DAYS=7
# Keep false until staging migration, backup/restore, SMTP and disk-threshold checks pass.
CLOUD_SYNC_FEATURE_ENABLED=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Required for the maintenance backup profile. The target must be off-server.
BACKUP_REMOTE=remote:tracelab-production
RCLONE_CONFIG_PATH=/root/.config/rclone/rclone.conf
