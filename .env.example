APP_NAME="Paper Code Trace Workbench"
APP_ENV=local
BACKEND_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,tauri://localhost,http://tauri.localhost,https://tauri.localhost
DATABASE_URL=sqlite:///./data/workbench.db
UPLOAD_ROOT=./uploads
GITHUB_CLONE_TIMEOUT_SECONDS=60

# Paper parsing: local MinerU or official MinerU API.
TRACELAB_MINERU_PROVIDER=local
TRACELAB_MINERU_URL=http://127.0.0.1:8001
TRACELAB_MINERU_BACKEND=pipeline
TRACELAB_MINERU_LANGUAGE=ch
TRACELAB_MINERU_PARSE_METHOD=auto
TRACELAB_MINERU_API_URL=https://mineru.net/api/v4
TRACELAB_MINERU_API_TOKEN=
TRACELAB_MINERU_API_MODEL=vlm
TRACELAB_MINERU_API_OCR=true
TRACELAB_MINERU_FORMULA_ENABLE=true
TRACELAB_MINERU_TABLE_ENABLE=true
TRACELAB_MINERU_REQUEST_TIMEOUT=60
TRACELAB_MINERU_REQUEST_RETRIES=3
TRACELAB_MINERU_TASK_TIMEOUT=600
TRACELAB_MINERU_POLL_INTERVAL=1
TRACELAB_PAPER_JOB_ROOT=./data/paper-jobs

# Optional OpenAI-compatible LLM for trace enhancement and Agent responses.
TRACELAB_LLM_ENABLED=false
TRACELAB_LLM_BASE_URL=
TRACELAB_LLM_API_KEY=
TRACELAB_LLM_MODEL=
# Optional provider extension; DeepSeek V4 JSON mode should use disabled.
TRACELAB_LLM_THINKING_MODE=
TRACELAB_LLM_TIMEOUT_SECONDS=20
TRACELAB_LLM_MAX_CANDIDATES=10
TRACELAB_LLM_MAX_CONTEXT_CHARS=12000
TRACELAB_AGENT_CONFIRMATION_TTL_SECONDS=900
